{
  "name": "marvel-heroes-app",
  "version": "1.0.0",
  "description": "A master-detail mobile app for learning about Marvel heroes with Clean Architecture",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@marvel-heroes/presentation-web",
    "start:mobile": "npm run start --workspace=@marvel-heroes/presentation-mobile",
    "start:web": "npm run start --workspace=@marvel-heroes/presentation-web",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:demo": "node simple-demo.js",
    "test:validation": "node test-runner.js",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "clean": "npm run clean --workspaces",
    "type-check": "npm run type-check --workspaces",
    "validate": "./scripts/validate-layer-isolation.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/marvel-heroes-app.git"
  },
  "keywords": [
    "react-native",
    "react",
    "typescript",
    "clean-architecture",
    "marvel",
    "heroes"
  ],
  "author": "Marvel Heroes Team",
  "license": "MIT"
}
