{
  "name": "marvel-heroes-app",
  "version": "1.0.0",
  "description": "A master-detail mobile app for learning about Marvel heroes with Clean Architecture",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start:web",
    "start:web": "cd apps/web && npm run start",
    "start:mobile": "cd apps/mobile && npm run start",
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npm run dev",
    "build:web": "cd apps/web && npm run build",
    "build:mobile": "cd apps/mobile && npm run build",
    "test:web": "cd apps/web && npm run test",
    "test:mobile": "cd apps/mobile && npm run test",
    "lint:web": "cd apps/web && npm run lint",
    "lint:mobile": "cd apps/mobile && npm run lint",
    "install:web": "cd apps/web && npm install",
    "install:mobile": "cd apps/mobile && npm install",
    "install:all": "npm install && npm run install:web && npm run install:mobile",
    "test:demo": "node simple-demo.js",
    "test:validation": "node test-runner.js",
    "validate": "./scripts/validate-layer-isolation.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/marvel-heroes-app.git"
  },
  "keywords": [
    "react-native",
    "react",
    "typescript",
    "clean-architecture",
    "marvel",
    "heroes"
  ],
  "author": "Marvel Heroes Team",
  "license": "MIT"
}
