{
  "name": "marvel-heroes-app",
  "version": "1.0.0",
  "description": "A master-detail mobile app for learning about Marvel heroes with Clean Architecture",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "scripts": {
    "start": "npm-run-all -p start:web start:mobile",
    "start:web": "cd packages/react-app && npm run dev -- --host",
    "start:mobile": "cd packages/rnApp && npm run start",
    "android": "cd packages/rnApp && npm run android",
    "ios": "cd packages/rnApp && npm run ios",
    "android:release": "cd packages/rnApp && npm run android:release",
    "ios:release": "cd packages/rnApp && npm run ios:release",
    "mobile:init": "cd packages/rnApp && npm run init",
    "mobile:init:ios": "cd packages/rnApp && npm run init:ios",
    "mobile:init:android": "cd packages/rnApp && npm run init:android",
    "test:demo": "node simple-demo.js",
    "test:validation": "node test-runner.js",
    "validate": "./scripts/validate-layer-isolation.sh"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/marvel-heroes-app.git"
  },
  "keywords": [
    "react-native",
    "react",
    "typescript",
    "clean-architecture",
    "marvel",
    "heroes"
  ],
  "author": "Marvel Heroes Team",
  "license": "MIT"
}
