{
  "name": "@marvel-heroes/presentation-web",
  "version": "1.0.0",
  "description": "Web presentation layer - React web pages and components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "echo 'Web app would start here - requires React development server setup'",
    "dev": "echo 'Web dev server would start here'",
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:fix": "eslint src/**/*.ts src/**/*.tsx --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@marvel-heroes/application": "file:../application",
    "@marvel-heroes/shared": "file:../shared",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-redux": ">=9.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "css-modules-typescript-loader": "^4.0.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-redux": ">=9.0.0"
  },
  "files": [
    "dist"
  ]
}
