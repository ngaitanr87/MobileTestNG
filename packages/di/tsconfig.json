{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "composite": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ],
  "references": [
    {
      "path": "../domain"
    },
    {
      "path": "../application"
    },
    {
      "path": "../infra-mobile"
    },
    {
      "path": "../infra-web"
    },
    {
      "path": "../shared"
    }
  ]
}